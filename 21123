-- === 4. ОПТИМИЗАЦИЯ И FPS BOOST ===
local function ActivateFPSBoost()
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	Lighting.GlobalShadows = false
	Lighting.ShadowSoftness = 0
	Lighting.ClockTime = 16.5

	for _, object in pairs(Workspace:GetDescendants()) do
		if object:IsA("BasePart") then
			if not originalMaterials[object] then
				originalMaterials[object] = {mat = object.Material, shadow = object.CastShadow, ref = object.Reflectance}
			end
			object.Material = Enum.Material.SmoothPlastic
			object.CastShadow = false
			object.Reflectance = 0
		elseif object:IsA("Decal") or object:IsA("Texture") or object:IsA("SunRaysEffect") or object:IsA("Clouds") then
			table.insert(hiddenObjects, {obj = object, oldParent = object.Parent})
			object.Parent = HiddenStorage
		elseif object:IsA("ParticleEmitter") or object:IsA("Smoke") or object:IsA("Fire") or object:IsA("Sparkles") then
			object.Enabled = false
			table.insert(hiddenObjects, {obj = object, isParticle = true})
		end
	end

	if atmosphere then atmosphere.Density = 0.25 atmosphere.Glare = 0 atmosphere.Haze = 1 end
	if colorCorrection then colorCorrection.Brightness = 0.15 colorCorrection.Contrast = 0.3 colorCorrection.Saturation = 0.5 end
	if bloom then bloom.Intensity = 0.5 bloom.Size = 14 bloom.Threshold = 0.85 end
	
	UpdateReduxColors(CurrentColor)
	ForceRefreshSounds()
end

-- === 5. ПОЛНЫЙ СБРОС И ЗАКРЫТИЕ ===
local function DeactivateAndReset()
	if not isReduxActive then return end
	isReduxActive = false
	RunService:UnbindFromRenderStep("CameraStretch")

	settings().Rendering.QualityLevel = origQualityLevel
	Lighting.ClockTime = origClockTime
	Lighting.Ambient = origAmbient
	Lighting.OutdoorAmbient = origOutdoorAmbient
	Lighting.GlobalShadows = origGlobalShadows
	Lighting.ShadowSoftness = origShadowSoftness

	if atmosphere and atmosphere.Parent then
		if createdAtmosphere then atmosphere:Destroy() else atmosphere.Density = origAtmDensity atmosphere.Color = origAtmColor atmosphere.Decay = origAtmDecay end
	end
	if colorCorrection and colorCorrection.Parent then
		if createdColorCorrection then colorCorrection:Destroy() else colorCorrection.Brightness = origCcBrightness colorCorrection.Contrast = origCcContrast colorCorrection.Saturation = origCcSaturation colorCorrection.TintColor = origCcTintColor end
	end
	if bloom and bloom.Parent then
		if createdBloom then bloom:Destroy() else bloom.Intensity = origBloomInt bloom.Size = origBloomSize bloom.Threshold = origBloomThresh end
	end

	for part, orig in pairs(originalMaterials) do
		if part and part.Parent then
			part.Material = orig.mat
			part.CastShadow = orig.shadow
			part.Reflectance = orig.ref
		end
	end

	for _, data in pairs(hiddenObjects) do
		if data.obj then
			if data.isParticle then data.obj.Enabled = true elseif data.oldParent then data.obj.Parent = data.oldParent end
		end
	end

	for sound, oldId in pairs(originalSoundIds) do
		if sound and sound.Parent then sound.SoundId = oldId end
	end

	if HiddenStorage then HiddenStorage:Destroy() end
	local gui = PlayerGui:FindFirstChild("RayfieldStyleGui")
	if gui then gui:Destroy() end
	script:Destroy()
end

