-- === 1. СИСТЕМА РАЗРЕШЕНИЯ КАМЕРЫ (ИСПРАВЛЕНО ДЛЯ ОБФУСКАТОРА) ===
-- Взамен Enum.RenderPriority.Camera.Value + 1 используем явное числоное значение приоритета (2001)
local CAMERA_PRIORITY = 2001

RunService:BindToRenderStep("CameraStretch", CAMERA_PRIORITY, function()
	local Camera = Workspace.CurrentCamera
	if isReduxActive and Camera then
		Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, Resolution, 0, 0, 0, 1)
	end
end)

local function darkenColor(color, amount)
	return Color3.new(math.max(color.R - amount, 0), math.max(color.G - amount, 0), math.max(color.B - amount, 0))
end

-- === 2. ОБНОВЛЕНИЕ ЦВЕТА ===
local function UpdateReduxColors(newColor)
	if not isReduxActive then return end
	CurrentColor = newColor
	Lighting.Ambient = darkenColor(newColor, 0.3)
	Lighting.OutdoorAmbient = newColor
	if atmosphere then
		atmosphere.Color = newColor
		atmosphere.Decay = darkenColor(newColor, 0.4)
	end
	if colorCorrection then
		colorCorrection.TintColor = newColor:Lerp(Color3.fromRGB(255, 255, 255), 0.7)
	end
end

-- === 3. ЗВУКОВАЯ СИСТЕМА ===
local function GetNextGunSound()
	if CustomUserGunSound ~= "" then
		return CustomUserGunSound
	elseif SelectedSoundIndex > 0 then
		return CustomGunSounds[SelectedSoundIndex]
	else
		local id = CustomGunSounds[globalSoundIndex]
		globalSoundIndex = (globalSoundIndex % #CustomGunSounds) + 1
		return id
	end
end

local function IsUISound(sound)
	return sound:IsDescendantOf(PlayerGui) or sound:IsDescendantOf(game:GetService("CoreGui")) or sound.Parent == SoundService
end

local function IsGunSound(sound)
	if IsUISound(sound) then return false end
	local name = sound.Name:lower()
	local gunKeywords = {"fire", "shot", "shoot", "bang", "blast"}
	for _, kw in ipairs(gunKeywords) do
		if name:find(kw) then return true end
	end
	return false
end

local function IsFootstepSound(sound)
	if IsUISound(sound) then return false end
	local name = sound.Name:lower()
	local stepKeywords = {"step", "run", "foot", "walk", "running"}
	for _, kw in ipairs(stepKeywords) do
		if name:find(kw) then return true end
	end
	return false
end

local function ApplySoundModification(sound)
	if not sound:IsA("Sound") or IsUISound(sound) then return end
	local isGun = IsGunSound(sound)
	local isStep = IsFootstepSound(sound)

	if not isGun and not isStep then return end

	if not originalSoundIds[sound] then
		originalSoundIds[sound] = sound.SoundId
	end

	if isStep then
		sound.SoundId = SingleFootstepId
		sound.Volume = FootstepVolume
	elseif isGun then
		sound.SoundId = GetNextGunSound()
	end
end

local function HookSoundEvents(sound)
	if not sound:IsA("Sound") or IsUISound(sound) or hookedSounds[sound] then return end
	local isGun = IsGunSound(sound)
	local isStep = IsFootstepSound(sound)

	if not isGun and not isStep then return end

	hookedSounds[sound] = true
	ApplySoundModification(sound)

	sound.Played:Connect(function()
		if not isReduxActive then return end
		if IsGunSound(sound) then
			sound.SoundId = GetNextGunSound()
		end
	end)
end

local function ForceRefreshSounds()
	local searchContainers = { Workspace, SoundService, Player.Backpack }
	if Player.Character then table.insert(searchContainers, Player.Character) end

	for _, container in ipairs(searchContainers) do
		for _, object in pairs(container:GetDescendants()) do
			if object:IsA("Sound") then HookSoundEvents(object) end
		end
	end
end

game.DescendantAdded:Connect(function(obj)
	if obj:IsA("Sound") then HookSoundEvents(obj) end
end)

if Player.Character then ForceRefreshSounds() end
