local function T(key)
	return (Translations[currentLang] and Translations[currentLang][key]) or key
end

-- ==========================================
-- СИСТЕМА АВТООБНОВЛЕНИЯ ЯЗЫКА (через атрибуты)
-- ==========================================

local function SetTrackedText(guiObj, key, prefix, suffix)
	guiObj:SetAttribute("_LangKey", key)
	guiObj:SetAttribute("_LangPrefix", prefix or "")
	guiObj:SetAttribute("_LangSuffix", suffix or "")
	guiObj.Text = (prefix or "") .. T(key) .. (suffix or "")
end

local function SetTrackedPlaceholder(guiObj, key)
	guiObj:SetAttribute("_LangPlaceholderKey", key)
	guiObj.PlaceholderText = T(key)
end

local function RefreshLanguage()
	for _, desc in ScreenGui:GetDescendants() do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
			local key = desc:GetAttribute("_LangKey")
			if key then
				local prefix = desc:GetAttribute("_LangPrefix") or ""
				local suffix = desc:GetAttribute("_LangSuffix") or ""
				desc.Text = prefix .. T(key) .. suffix
			end
			local phKey = desc:GetAttribute("_LangPlaceholderKey")
			if phKey then
				desc.PlaceholderText = T(phKey)
			end
		end
	end
end

-- Звуковой движок
local function PlaySound(id, vol, pitch)
	task.spawn(function()
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. tostring(id)
		s.Volume = vol or 1
		s.PlaybackSpeed = pitch or 1
		s.Parent = ScreenGui
		s:Play()
		s.Ended:Connect(function() s:Destroy() end)
	end)
end

-- ==========================================
-- 1. ПЛАВНЫЙ КУРСОР И ИНЕРЦИОННЫЙ ДРАГ
-- ==========================================

local CustomCursor = Instance.new("Frame")
CustomCursor.Name = "IOSCursor"
CustomCursor.Size = UDim2.new(0, 12, 0, 12)
CustomCursor.AnchorPoint = Vector2.new(0.5, 0.5)
CustomCursor.BackgroundColor3 = Color3.fromRGB(255, 45, 70)
CustomCursor.BorderSizePixel = 0
CustomCursor.ZIndex = 999999
CustomCursor.Visible = false
CustomCursor.Parent = ScreenGui
Instance.new("UICorner", CustomCursor).CornerRadius = UDim.new(1, 0)

local CursorStroke = Instance.new("UIStroke")
CursorStroke.Color = Color3.fromRGB(255, 255, 255)
CursorStroke.Thickness = 1.5
CursorStroke.Transparency = 0.2
CursorStroke.Parent = CustomCursor

local currentCursorPos = Vector2.new(0,0)
local mainHubFrame = nil

local isDragging = false
local dragStartMouse = Vector2.new()
local startFramePos = Vector2.new()
local targetFrameOffset = Vector2.new(0, 0)
local currentFrameOffset = Vector2.new(0, 0)

RunService.RenderStepped:Connect(function()
	local mousePos = UserInputService:GetMouseLocation()

	if mainHubFrame and mainHubFrame.Parent and mainHubFrame.Visible and mainHubFrame.GroupTransparency < 0.8 then
		local guiPos = mainHubFrame.AbsolutePosition
		local guiSize = mainHubFrame.AbsoluteSize

		local inBounds = mousePos.X >= guiPos.X and mousePos.X <= (guiPos.X + guiSize.X)
			and mousePos.Y >= (guiPos.Y - 36) and mousePos.Y <= (guiPos.Y + guiSize.Y)

		if inBounds then
			UserInputService.MouseIconEnabled = false
			CustomCursor.Visible = true
			currentCursorPos = currentCursorPos:Lerp(mousePos, 0.35)
			CustomCursor.Position = UDim2.new(0, currentCursorPos.X, 0, currentCursorPos.Y)
		else
			UserInputService.MouseIconEnabled = true
			CustomCursor.Visible = false
			currentCursorPos = mousePos
		end
	else
		UserInputService.MouseIconEnabled = true
		CustomCursor.Visible = false
	end

	if isDragging then
		local delta = mousePos - dragStartMouse
		targetFrameOffset = startFramePos + delta
	end

	if mainHubFrame then
		currentFrameOffset = currentFrameOffset:Lerp(targetFrameOffset, 0.2)
		mainHubFrame.Position = UDim2.new(0.5, currentFrameOffset.X, 0.5, currentFrameOffset.Y)
	end
end)

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and CustomCursor.Visible then
		TweenService:Create(CustomCursor, TweenInfo.new(0.1), {Size = UDim2.new(0, 8, 0, 8)}):Play()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		TweenService:Create(CustomCursor, TweenInfo.new(0.15), {Size = UDim2.new(0, 12, 0, 12)}):Play()
	end
end)

