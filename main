local ReduxLibrary = {}

function ReduxLibrary:CreateWindow(hubTitleText, versionText)
	local windowObj = {}
	local toggleKeycode = Enum.KeyCode.RightControl

	local MainFrame = Instance.new("CanvasGroup")
	MainFrame.Size = UDim2.new(0, 540, 0, 350)
	MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
	MainFrame.BackgroundTransparency = 0.15
	MainFrame.BorderSizePixel = 0
	MainFrame.GroupTransparency = 1
	MainFrame.ClipsDescendants = true
	MainFrame.Parent = ScreenGui

	mainHubFrame = MainFrame
	Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 20)

	local MainGradient = Instance.new("UIGradient")
	MainGradient.Color = ColorSequence.new(Color3.fromRGB(26, 26, 34), Color3.fromRGB(18, 18, 24))
	MainGradient.Rotation = 90
	MainGradient.Parent = MainFrame

	local MainStroke = Instance.new("UIStroke")
	MainStroke.Color = Color3.fromRGB(255, 255, 255)
	MainStroke.Thickness = 1
	MainStroke.Transparency = 0.85
	MainStroke.Parent = MainFrame

	local MainStrokeGradient = Instance.new("UIGradient")
	MainStrokeGradient.Color = ColorSequence.new(Color3.fromRGB(255, 45, 70), Color3.fromRGB(100, 100, 140))
	MainStrokeGradient.Rotation = 90
	MainStrokeGradient.Parent = MainStroke

	-- Сайдбар слева
	local Sidebar = Instance.new("Frame")
	Sidebar.Size = UDim2.new(0, 150, 1, 0)
	Sidebar.Position = UDim2.new(0, 0, 0, 0)
	Sidebar.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
	Sidebar.BackgroundTransparency = 0.4
	Sidebar.BorderSizePixel = 0
	Sidebar.Parent = MainFrame

	local SidebarGradient = Instance.new("UIGradient")
	SidebarGradient.Color = ColorSequence.new(Color3.fromRGB(28, 28, 38), Color3.fromRGB(22, 22, 30))
	SidebarGradient.Rotation = 90
	SidebarGradient.Parent = Sidebar

	-- ЧИСТЫЙ ПРОФИЛЬ ВВЕРХУ (БЕЗ КРАСНОГО ПРЯМОУГОЛЬНИКА)
	local ProfileArea = Instance.new("Frame")
	ProfileArea.Size = UDim2.new(1, 0, 0, 115)
	ProfileArea.BackgroundTransparency = 1 -- Абсолютно чистый прозрачный фон!
	ProfileArea.Parent = Sidebar

	local AvatarImage = Instance.new("ImageLabel")
	AvatarImage.Size = UDim2.new(0, 60, 0, 60)
	AvatarImage.Position = UDim2.new(0.5, 0, 0, 14)
	AvatarImage.AnchorPoint = Vector2.new(0.5, 0)
	AvatarImage.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
	AvatarImage.BackgroundTransparency = 1
	AvatarImage.BorderSizePixel = 0
	AvatarImage.Parent = ProfileArea
	Instance.new("UICorner", AvatarImage).CornerRadius = UDim.new(1, 0)

	local AvatarStroke = Instance.new("UIStroke")
	AvatarStroke.Color = Color3.fromRGB(255, 45, 70)
	AvatarStroke.Thickness = 2.5
	AvatarStroke.Parent = AvatarImage

	task.spawn(function()
		local content, isLoaded = Players:GetUserThumbnailAsync(
			LocalPlayer.UserId,
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size150x150
		)
		if isLoaded then AvatarImage.Image = content end
	end)

	-- ЧИСТЫЙ ТЕКСТ НИКА БЕЗ ПРЯМОУГОЛЬНИКОВ
	local NameLabel = Instance.new("TextLabel")
	NameLabel.Size = UDim2.new(1, -10, 0, 20)
	NameLabel.Position = UDim2.new(0.5, 0, 0, 84)
	NameLabel.AnchorPoint = Vector2.new(0.5, 0)
	NameLabel.BackgroundTransparency = 1 -- Чистый фон!
	NameLabel.Text = LocalPlayer.Name
	NameLabel.TextColor3 = Color3.fromRGB(240, 240, 255)
	NameLabel.Font = Enum.Font.GothamBold
	NameLabel.TextSize = 13
	NameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	NameLabel.Parent = ProfileArea

	-- Контейнер для вкладок
	local TabContainer = Instance.new("Frame")
	TabContainer.Size = UDim2.new(1, 0, 1, -115)
	TabContainer.Position = UDim2.new(0, 0, 0, 115)
	TabContainer.BackgroundTransparency = 1
	TabContainer.Parent = Sidebar

	local TabIndicator = Instance.new("Frame")
	TabIndicator.Size = UDim2.new(1, -16, 0, 36)
	TabIndicator.Position = UDim2.new(0, 8, 0, 0)
	TabIndicator.BackgroundColor3 = Color3.fromRGB(255, 45, 70)
	TabIndicator.BorderSizePixel = 0
	TabIndicator.Parent = TabContainer
	Instance.new("UICorner", TabIndicator).CornerRadius = UDim.new(0, 10)

	local TabIndicatorGradient = Instance.new("UIGradient")
	TabIndicatorGradient.Color = ColorSequence.new(Color3.fromRGB(255, 80, 100), Color3.fromRGB(220, 30, 55))
	TabIndicatorGradient.Rotation = 90
	TabIndicatorGradient.Parent = TabIndicator

	local SidebarList = Instance.new("UIListLayout")
	SidebarList.Padding = UDim.new(0, 6)
	SidebarList.SortOrder = Enum.SortOrder.LayoutOrder
	SidebarList.Parent = TabContainer

	local SidebarPadding = Instance.new("UIPadding")
	SidebarPadding.PaddingLeft = UDim.new(0, 8)
	SidebarPadding.PaddingRight = UDim.new(0, 8)
	SidebarPadding.Parent = TabContainer

	-- Шапка справа
	local TopBar = Instance.new("Frame")
	TopBar.Size = UDim2.new(1, -150, 0, 44)
	TopBar.Position = UDim2.new(0, 150, 0, 0)
	TopBar.BackgroundTransparency = 1
	TopBar.Parent = MainFrame

	local HeaderTitle = Instance.new("TextLabel")
	HeaderTitle.Size = UDim2.new(1, -60, 1, 0)
	HeaderTitle.Position = UDim2.new(0, 15, 0, 0)
	HeaderTitle.BackgroundTransparency = 1
	HeaderTitle.RichText = true
	HeaderTitle.Text = '<b><font color="#ff2d46">' .. (hubTitleText or "REDUX HUB") .. '</font></b>  <font color="#555566">|</font>  <font color="#aaaa88">' .. (versionText or "0.2 beta") .. '</font>'
	HeaderTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	HeaderTitle.Font = Enum.Font.GothamBold
	HeaderTitle.TextSize = 14
	HeaderTitle.TextXAlignment = Enum.TextXAlignment.Left
	HeaderTitle.Parent = TopBar

	local CloseBtn = Instance.new("TextButton")
	CloseBtn.Size = UDim2.new(0, 26, 0, 26)
	CloseBtn.Position = UDim2.new(1, -34, 0, 9)
	CloseBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
	CloseBtn.BackgroundTransparency = 0.3
	CloseBtn.Text = "✕"
	CloseBtn.TextColor3 = Color3.fromRGB(200, 200, 215)
	CloseBtn.Font = Enum.Font.GothamBold
	CloseBtn.TextSize = 12
	CloseBtn.AutoButtonColor = false
	CloseBtn.Parent = TopBar
	Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(1, 0)

	CloseBtn.MouseEnter:Connect(function()
		TweenService:Create(CloseBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(180, 40, 55), BackgroundTransparency = 0}):Play()
		TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
	end)
	CloseBtn.MouseLeave:Connect(function()
		TweenService:Create(CloseBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 58), BackgroundTransparency = 0.3}):Play()
		TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(200, 200, 215)}):Play()
	end)

	local function ToggleWindow(visible)
		if visible == nil then visible = not MainFrame.Visible end
		PlaySound(6895079853, 0.7, 1.1)
		if visible then
			MainFrame.Visible = true
			TweenService:Create(MainFrame, TweenInfo.new(0.3), {GroupTransparency = 0}):Play()
		else
			TweenService:Create(MainFrame, TweenInfo.new(0.3), {GroupTransparency = 1}):Play()
			task.wait(0.3)
			if MainFrame.GroupTransparency >= 0.9 then MainFrame.Visible = false end
		end
	end

	CloseBtn.MouseButton1Click:Connect(function()
		UserInputService.MouseIconEnabled = true
		ScreenGui:Destroy()
	end)

	TopBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			dragStartMouse = UserInputService:GetMouseLocation()
			startFramePos = targetFrameOffset
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false
		end
	end)

	-- БИНД ГЛОБАЛЬНЫЙ
	UserInputService.InputBegan:Connect(function(input, gpe)
		if not gpe and input.KeyCode == toggleKeycode then
			ToggleWindow()
		end
	end)

	-- Content Area
	local ContentArea = Instance.new("Frame")
	ContentArea.Size = UDim2.new(1, -150, 1, -44)
	ContentArea.Position = UDim2.new(0, 150, 0, 44)
	ContentArea.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
	ContentArea.BackgroundTransparency = 0.2
	ContentArea.BorderSizePixel = 0
	ContentArea.Parent = MainFrame

	local tabs = {}

	function windowObj:CreateTab(nameKey, iconText)
		local tabObj = {}
		local tabIndex = #tabs + 1

		local tabBtn = Instance.new("TextButton")
		tabBtn.Size = UDim2.new(1, 0, 0, 36)
		tabBtn.BackgroundTransparency = 1
		tabBtn.Text = (iconText or "📌") .. "  " .. T(nameKey)
		tabBtn:SetAttribute("_LangKey", nameKey)
		tabBtn:SetAttribute("_LangPrefix", (iconText or "📌") .. "  ")
		tabBtn:SetAttribute("_LangSuffix", "")
		tabBtn.TextColor3 = Color3.fromRGB(160, 160, 180)
		tabBtn.Font = Enum.Font.GothamSemibold
		tabBtn.TextSize = 13
		tabBtn.TextXAlignment = Enum.TextXAlignment.Left
		tabBtn.AutoButtonColor = false
		tabBtn.LayoutOrder = tabIndex
		tabBtn.Parent = TabContainer

		local btnPadding = Instance.new("UIPadding")
		btnPadding.PaddingLeft = UDim.new(0, 12)
		btnPadding.Parent = tabBtn

		tabBtn.MouseEnter:Connect(function()
			if tabBtn.TextColor3 == Color3.fromRGB(255, 255, 255) then return end
			TweenService:Create(tabBtn, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(210, 210, 230)}):Play()
		end)
		tabBtn.MouseLeave:Connect(function()
			if tabBtn.TextColor3 == Color3.fromRGB(255, 255, 255) then return end
			TweenService:Create(tabBtn, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(160, 160, 180)}):Play()
		end)

		local scroll = Instance.new("ScrollingFrame")
		scroll.Size = UDim2.new(1, 0, 1, 0)
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = 2
		scroll.ScrollBarImageColor3 = Color3.fromRGB(255, 45, 70)
		scroll.Visible = false
		scroll.Parent = ContentArea

		local list = Instance.new("UIListLayout")
		list.Padding = UDim.new(0, 10)
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Parent = scroll

		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 10)
		pad.PaddingLeft = UDim.new(0, 16)
		pad.PaddingRight = UDim.new(0, 16)
		pad.Parent = scroll

		table.insert(tabs, {Btn = tabBtn, Page = scroll, NameKey = nameKey, Icon = iconText})

		tabBtn.MouseButton1Click:Connect(function()
			PlaySound(6895079853, 0.6, 1.2)
			local targetY = (tabIndex - 1) * 42
			TweenService:Create(TabIndicator, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Position = UDim2.new(0, 8, 0, targetY)}):Play()

			for _, t in pairs(tabs) do
				t.Page.Visible = false
				TweenService:Create(t.Btn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(160, 160, 180)}):Play()
			end
			scroll.Visible = true
			TweenService:Create(tabBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		end)

		if tabIndex == 1 then
			scroll.Visible = true
			tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end

		-- ==========================================
		-- МЕТОДЫ ВКЛАДКИ (КОМПОНЕНТЫ)
		-- ==========================================

		-- РАЗДЕЛ (SECTION - НОВОЕ!)
		function tabObj:CreateSection(titleKey)
			local secCard = Instance.new("Frame")
			secCard.Size = UDim2.new(1, 0, 0, 24)
			secCard.BackgroundTransparency = 1
			secCard.Parent = scroll

			local secLabel = Instance.new("TextLabel")
			secLabel.Size = UDim2.new(1, 0, 1, 0)
			secLabel.BackgroundTransparency = 1
			SetTrackedText(secLabel, titleKey)
			secLabel.TextColor3 = Color3.fromRGB(255, 45, 70)
			secLabel.Font = Enum.Font.GothamBold
			secLabel.TextSize = 12
			secLabel.TextXAlignment = Enum.TextXAlignment.Left
			secLabel.Parent = secCard

			return secCard
		end

		-- Слайдер
		function tabObj:AddSlider(textKey, min, max, default, callback)
			local card = Instance.new("Frame")
			card.Size = UDim2.new(1, 0, 0, 48)
			card.BackgroundTransparency = 1
			card.Parent = scroll

			local title = Instance.new("TextLabel")
			title.Size = UDim2.new(1, -60, 0, 20)
			title.Position = UDim2.new(0, 0, 0, 0)
			title.BackgroundTransparency = 1
			SetTrackedText(title, textKey)
			title.TextColor3 = Color3.fromRGB(230, 230, 245)
			title.Font = Enum.Font.GothamMedium
			title.TextSize = 13
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.Parent = card

			local valLabel = Instance.new("TextLabel")
			valLabel.Size = UDim2.new(0, 50, 0, 20)
			valLabel.Position = UDim2.new(1, -50, 0, 0)
			valLabel.BackgroundTransparency = 1
			valLabel.Text = tostring(default or min)
			valLabel.TextColor3 = Color3.fromRGB(255, 45, 70)
			valLabel.Font = Enum.Font.GothamBold
			valLabel.TextSize = 14
			valLabel.TextXAlignment = Enum.TextXAlignment.Right
			valLabel.Parent = card

			local sliderBg = Instance.new("Frame")
			sliderBg.Size = UDim2.new(1, 0, 0, 6)
			sliderBg.Position = UDim2.new(0, 0, 0, 30)
			sliderBg.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
			sliderBg.BorderSizePixel = 0
			sliderBg.Parent = card
			Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

			local sliderFill = Instance.new("Frame")
			sliderFill.Size = UDim2.new(((default or min) - min)/(max - min), 0, 1, 0)
			sliderFill.BackgroundColor3 = Color3.fromRGB(255, 45, 70)
			sliderFill.BorderSizePixel = 0
			sliderFill.Parent = sliderBg
			Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

			local sliderGradient = Instance.new("UIGradient")
			sliderGradient.Color = ColorSequence.new(Color3.fromRGB(255, 80, 100), Color3.fromRGB(255, 45, 70))
			sliderGradient.Parent = sliderFill

			local knob = Instance.new("Frame")
			knob.Size = UDim2.new(0, 14, 0, 14)
			knob.Position = UDim2.new(1, -7, 0.5, -7)
			knob.BackgroundColor3 = Color3.fromRGB(255, 45, 70)
			knob.BorderSizePixel = 0
			knob.Parent = sliderFill
			Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

			local sliding = false
			local function update(input)
				local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
				local val = math.floor(min + (max - min) * pos)
				TweenService:Create(sliderFill, TweenInfo.new(0.05), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
				valLabel.Text = tostring(val)
				if callback then callback(val) end
			end

			sliderBg.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					update(input)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					update(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end)
		end

		-- Тумблер
		function tabObj:AddToggle(textKey, defaultState, callback)
			local card = Instance.new("Frame")
			card.Size = UDim2.new(1, 0, 0, 42)
			card.BackgroundTransparency = 1
			card.Parent = scroll

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, -60, 1, 0)
			label.Position = UDim2.new(0, 0, 0, 0)
			label.BackgroundTransparency = 1
			SetTrackedText(label, textKey)
			label.TextColor3 = Color3.fromRGB(230, 230, 245)
			label.Font = Enum.Font.GothamMedium
			label.TextSize = 13
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Parent = card

			local switchBg = Instance.new("Frame")
			switchBg.Size = UDim2.new(0, 40, 0, 22)
			switchBg.Position = UDim2.new(1, -40, 0.5, -11)
			switchBg.BackgroundColor3 = Color3.fromRGB(35, 45, 60)
			switchBg.Parent = card
			Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

			local switchStroke = Instance.new("UIStroke")
			switchStroke.Color = Color3.fromRGB(0, 150, 255)
			switchStroke.Thickness = 1
			switchStroke.Transparency = 0.5
			switchStroke.Parent = switchBg

			local knobLeft = Instance.new("Frame")
			knobLeft.Size = UDim2.new(0, 14, 0, 14)
			knobLeft.Position = UDim2.new(0, 4, 0.5, -7)
			knobLeft.BackgroundColor3 = Color3.fromRGB(50, 150, 255)
			knobLeft.Parent = switchBg
			Instance.new("UICorner", knobLeft).CornerRadius = UDim.new(1, 0)

			local knobRight = Instance.new("Frame")
			knobRight.Size = UDim2.new(0, 14, 0, 14)
			knobRight.Position = UDim2.new(1, -18, 0.5, -7)
			knobRight.BackgroundColor3 = Color3.fromRGB(255, 45, 70)
			knobRight.Parent = switchBg
			Instance.new("UICorner", knobRight).CornerRadius = UDim.new(1, 0)

			local state = defaultState or false
			local clickBtn = Instance.new("TextButton")
			clickBtn.Size = UDim2.new(1, 0, 1, 0)
			clickBtn.BackgroundTransparency = 1
			clickBtn.Text = ""
			clickBtn.Parent = card

			clickBtn.MouseButton1Click:Connect(function()
				state = not state
				PlaySound(6895079853, 0.7, state and 1.4 or 1.0)
				if state then
					TweenService:Create(knobRight, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 45, 70)}):Play()
					TweenService:Create(knobLeft, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 60, 90)}):Play()
					switchStroke.Color = Color3.fromRGB(255, 45, 70)
				else
					TweenService:Create(knobLeft, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 150, 255)}):Play()
					TweenService:Create(knobRight, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(90, 30, 40)}):Play()
					switchStroke.Color = Color3.fromRGB(0, 150, 255)
				end
				if callback then callback(state) end
			end)
		end

		-- Текстовое поле
		function tabObj:AddTextbox(textKey, placeholderKey, callback)
			local card = Instance.new("Frame")
			card.Size = UDim2.new(1, 0, 0, 42)
			card.BackgroundTransparency = 1
			card.Parent = scroll

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(0.45, 0, 1, 0)
			label.Position = UDim2.new(0, 0, 0, 0)
			label.BackgroundTransparency = 1
			SetTrackedText(label, textKey)
			label.TextColor3 = Color3.fromRGB(230, 230, 245)
			label.Font = Enum.Font.GothamMedium
			label.TextSize = 13
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Parent = card

			local boxBg = Instance.new("Frame")
			boxBg.Size = UDim2.new(0.55, 0, 0, 30)
			boxBg.Position = UDim2.new(0.45, 0, 0.5, -15)
			boxBg.BackgroundColor3 = Color3.fromRGB(28, 35, 48)
			boxBg.BackgroundTransparency = 0.3
			boxBg.Parent = card
			Instance.new("UICorner", boxBg).CornerRadius = UDim.new(0, 12)

			local boxStroke = Instance.new("UIStroke")
			boxStroke.Color = Color3.fromRGB(0, 140, 255)
			boxStroke.Thickness = 1
			boxStroke.Transparency = 0.5
			boxStroke.Parent = boxBg

			local searchIcon = Instance.new("TextLabel")
			searchIcon.Size = UDim2.new(0, 24, 1, 0)
			searchIcon.Position = UDim2.new(0, 6, 0, 0)
			searchIcon.BackgroundTransparency = 1
			searchIcon.Text = "🔍"
			searchIcon.TextSize = 11
			searchIcon.Parent = boxBg

			local box = Instance.new("TextBox")
			box.Size = UDim2.new(1, -34, 1, 0)
			box.Position = UDim2.new(0, 28, 0, 0)
			box.BackgroundTransparency = 1
			SetTrackedPlaceholder(box, placeholderKey)
			box.Text = ""
			box.TextColor3 = Color3.fromRGB(255, 255, 255)
			box.PlaceholderColor3 = Color3.fromRGB(130, 140, 160)
			box.Font = Enum.Font.Gotham
			box.TextSize = 12
			box.ClearTextOnFocus = false
			box.Parent = boxBg

			box.FocusLost:Connect(function(enterPressed)
				if callback then callback(box.Text, enterPressed) end
			end)
		end

		-- Выпадающий список (Dropdown)
		function tabObj:AddDropdown(textKey, options, default, callback)
			local card = Instance.new("Frame")
			card.Size = UDim2.new(1, 0, 0, 42)
			card.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
			card.BackgroundTransparency = 0.4
			card.ClipsDescendants = true
			card.Parent = scroll
			Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)

			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(255, 255, 255)
			stroke.Transparency = 0.9
			stroke.Thickness = 1
			stroke.Parent = card

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, -120, 0, 42)
			label.Position = UDim2.new(0, 14, 0, 0)
			label.BackgroundTransparency = 1
			SetTrackedText(label, textKey)
			label.TextColor3 = Color3.fromRGB(230, 230, 245)
			label.Font = Enum.Font.GothamMedium
			label.TextSize = 13
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Parent = card

			local selectedLabel = Instance.new("TextLabel")
			selectedLabel.Size = UDim2.new(0, 100, 0, 42)
			selectedLabel.Position = UDim2.new(1, -114, 0, 0)
			selectedLabel.BackgroundTransparency = 1
			selectedLabel.Text = (default or options[1] or "") .. "  ▼"
			selectedLabel.TextColor3 = Color3.fromRGB(255, 45, 70)
			selectedLabel.Font = Enum.Font.GothamBold
			selectedLabel.TextSize = 12
			selectedLabel.TextXAlignment = Enum.TextXAlignment.Right
			selectedLabel.Parent = card

			local clickBtn = Instance.new("TextButton")
			clickBtn.Size = UDim2.new(1, 0, 0, 42)
			clickBtn.BackgroundTransparency = 1
			clickBtn.Text = ""
			clickBtn.Parent = card

			local optionHolder = Instance.new("Frame")
			optionHolder.Size = UDim2.new(1, -28, 0, #options * 32)
			optionHolder.Position = UDim2.new(0, 14, 0, 42)
			optionHolder.BackgroundTransparency = 1
			optionHolder.Parent = card

			local listLayout = Instance.new("UIListLayout")
			listLayout.Padding = UDim.new(0, 4)
			listLayout.Parent = optionHolder

			local isOpen = false
			clickBtn.MouseButton1Click:Connect(function()
				isOpen = not isOpen
				PlaySound(6895079853, 0.6, 1.1)
				local targetHeight = isOpen and (46 + #options * 34) or 42
				TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
			end)

			for _, opt in ipairs(options) do
				local optBtn = Instance.new("TextButton")
				optBtn.Size = UDim2.new(1, 0, 0, 30)
				optBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
				optBtn.BackgroundTransparency = 0.5
				optBtn.Text = opt
				optBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
				optBtn.Font = Enum.Font.Gotham
				optBtn.TextSize = 12
				optBtn.Parent = optionHolder
				Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 6)

				optBtn.MouseButton1Click:Connect(function()
					PlaySound(6895079853, 0.7, 1.3)
					selectedLabel.Text = opt .. "  ▼"
					isOpen = false
					TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), {Size = UDim2.new(1, 0, 0, 42)}):Play()
					if callback then callback(opt) end
				end)
			end
		end

		-- Кнопка
		function tabObj:AddButton(textKey, callback)
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 40)
			btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
			btn.BackgroundTransparency = 0.4
			SetTrackedText(btn, textKey)
			btn.TextColor3 = Color3.fromRGB(230, 230, 245)
			btn.Font = Enum.Font.GothamSemibold
			btn.TextSize = 13
			btn.AutoButtonColor = false
			btn.Parent = scroll
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(255, 255, 255)
			stroke.Transparency = 0.9
			stroke.Thickness = 1
			stroke.Parent = btn

			btn.MouseEnter:Connect(function()
				TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 55), BackgroundTransparency = 0.2}):Play()
				TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.7, Color = Color3.fromRGB(255, 45, 70)}):Play()
			end)
			btn.MouseLeave:Connect(function()
				TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 28, 38), BackgroundTransparency = 0.4}):Play()
				TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.9, Color = Color3.fromRGB(255, 255, 255)}):Play()
			end)

			btn.MouseButton1Click:Connect(function()
				PlaySound(6895079853, 0.8, 1.2)
				TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, 0, 0, 36)}):Play()
				task.wait(0.1)
				TweenService:Create(btn, TweenInfo.new(0.15), {Size = UDim2.new(1, 0, 0, 40)}):Play()
				if callback then callback() end
			end)
		end

		-- Клавиша бинда (Keybind Selector)
		function tabObj:AddKeybind(textKey, defaultKey, callback)
			local card = Instance.new("Frame")
			card.Size = UDim2.new(1, 0, 0, 42)
			card.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
			card.BackgroundTransparency = 0.4
			card.Parent = scroll
			Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, -120, 1, 0)
			label.Position = UDim2.new(0, 14, 0, 0)
			label.BackgroundTransparency = 1
			SetTrackedText(label, textKey)
			label.TextColor3 = Color3.fromRGB(230, 230, 245)
			label.Font = Enum.Font.GothamMedium
			label.TextSize = 13
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Parent = card

			local keyBtn = Instance.new("TextButton")
			keyBtn.Size = UDim2.new(0, 95, 0, 26)
			keyBtn.Position = UDim2.new(1, -105, 0.5, -13)
			keyBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
			keyBtn.Text = defaultKey.Name
			keyBtn.TextColor3 = Color3.fromRGB(255, 45, 70)
			keyBtn.Font = Enum.Font.GothamBold
			keyBtn.TextSize = 12
			keyBtn.Parent = card
			Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0, 6)

			local binding = false
			keyBtn.MouseButton1Click:Connect(function()
				binding = true
				keyBtn.Text = "..."
				local conn
				conn = UserInputService.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.Keyboard then
						binding = false
						toggleKeycode = input.KeyCode
						keyBtn.Text = input.KeyCode.Name
						conn:Disconnect()
						if callback then callback(input.KeyCode) end
					end
				end)
			end)
		end

		return tabObj
	end

	PlaySound(2865227271, 1.2, 1)
	TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()

	windowObj.ToggleWindow = ToggleWindow
	return windowObj
end

-- ==========================================
-- 4. ЗАПУСК ЛОАДЕРА И ПРИМЕР С МУЛЬТИЯЗЫЧНОСТЬЮ
-- ==========================================

task.spawn(function()
	PlaySound(6895079853, 0.8, 1)
	TweenService:Create(LoaderFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 1, -40)}):Play()
	task.wait(0.6)

	local function UpdateProgress(text, percent, duration)
		StatusLabel.Text = text
		local anim = TweenService:Create(ProgressBar, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(percent, 0, 1, 0)})
		anim:Play()
		task.wait(duration + 0.1)
	end

	UpdateProgress(T("Connecting"), 0.35, 0.6)
	UpdateProgress(T("Injecting"), 0.7, 0.6)
	UpdateProgress(T("Ready"), 1, 0.3)

	PlaySound(8504711311, 1.5, 1)
	TweenService:Create(LoaderStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(50, 255, 100)}):Play()
	TweenService:Create(ProgressBar, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(50, 255, 100)}):Play()
	StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	task.wait(0.5)

	PlaySound(6895079853, 0.8, 0.9)
	local downAnim = TweenService:Create(LoaderFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Position = UDim2.new(0.5, 0, 1, 100)})
	downAnim:Play()
	downAnim.Completed:Wait()
	LoaderFrame:Destroy()

	-- СОЗДАНИЕ ГЛАВНОГО ОКНА
	local Window = ReduxLibrary:CreateWindow("REDUX HUB", "0.2 beta")

	-- ВКЛАДКА 1: ПЕРСОНАЖ
	local PlayerTab = Window:CreateTab("PlayerCategory", "⚡")
	PlayerTab:CreateSection("MovementSection")

	PlayerTab:AddSlider("WalkSpeed", 16, 200, 16, function(value)
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("Humanoid") then
			char.Humanoid.WalkSpeed = value
		end
	end)

	local infJumpEnabled = false
	UserInputService.JumpRequest:Connect(function()
		if infJumpEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
	PlayerTab:AddToggle("InfJump", false, function(state)
		infJumpEnabled = state
	end)

	PlayerTab:AddTextbox("Teleport", "PlayerPlaceholder", function(text, enterPressed)
		if enterPressed and text ~= "" then
			print("Teleport to: " .. text)
		end
	end)

	-- ВКЛАДКА 2: ВИЗУАЛ
	local VisualTab = Window:CreateTab("VisualCategory", "👁")
	VisualTab:CreateSection("VisualSection")

	local espEnabled = false
	VisualTab:AddToggle("ESP", false, function(state)
		espEnabled = state
		if not state then
			for _, p in pairs(Players:GetPlayers()) do
				if p.Character and p.Character:FindFirstChild("ReduxESP") then
					p.Character.ReduxESP:Destroy()
				end
			end
		end
	end)

	task.spawn(function()
		while task.wait(1) do
			if espEnabled then
				for _, p in pairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						if not p.Character:FindFirstChild("ReduxESP") then
							local h = Instance.new("Highlight")
							h.Name = "ReduxESP"
							h.FillColor = Color3.fromRGB(255, 45, 70)
							h.OutlineColor = Color3.fromRGB(255, 255, 255)
							h.FillTransparency = 0.5
							h.OutlineTransparency = 0
							h.Parent = p.Character
						end
					end
				end
			end
		end
	end)

	VisualTab:AddDropdown("ESPColor", {"Red", "Blue", "Green"}, "Red", function(selected)
		print("Selected ESP Color: " .. selected)
	end)

	-- ВКЛАДКА 3: НАСТРОЙКИ (СМЕНА ЯЗЫКА И УПРАВЛЕНИЕ)
	local SettingsTab = Window:CreateTab("Settings", "⚙️")
	SettingsTab:CreateSection("SystemSection")

	-- Выбор языка (RU / EN / UA)
	SettingsTab:AddDropdown("Language", {"Русский", "English", "Українська"}, "Русский", function(langName)
		if langName == "Русский" then currentLang = "RU"
		elseif langName == "English" then currentLang = "EN"
		elseif langName == "Українська" then currentLang = "UA" end
		RefreshLanguage()
		PlaySound(8504711311, 1.0, 1.2)
		print("UI Language changed to: " .. currentLang)
	end)

	-- Настройка бинда скрытия
	SettingsTab:AddKeybind("ToggleKey", Enum.KeyCode.RightControl, function(newKey)
		print("New UI Keybind: " .. newKey.Name)
	end)

	-- Кнопка скрыть меню
	SettingsTab:AddButton("HideUI", function()
		Window:ToggleWindow(false)
	end)

	-- Кнопка полного удаления
	SettingsTab:AddButton("Unload", function()
		UserInputService.MouseIconEnabled = true
		ScreenGui:Destroy()
	end)
end)
